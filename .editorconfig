root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
# Compose convention: @Composable functions are PascalCase. Without this
# exception ktlint's standard:function-naming rule flags every UI composable.
ktlint_function_naming_ignore_when_annotated_with = Composable
